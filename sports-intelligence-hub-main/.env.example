# Jira Integration (Server-side)
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=KAN

# Google Apps Script Analytics & Leads Backend
# Paste your deployed Web App /exec URL here.
# Get it from: Apps Script → Deploy → Manage Deployments → Web app URL
#
# This single endpoint handles BOTH:
#   1. Analytics events (greeting_shown, navigation_context_shown, chatbot_opened,
#      contact_form_viewed, contact_form_submitted, contact_form_submission_failed)
#   2. Contact lead submissions (event: "contact_lead") — sent to Contact_Leads sheet.
#      Lead payload fields: name, email, role, organization, details, page,
#      visitorId, sessionId, timestamp, sport, requirement, hasPhone, hasAdditionalDetails
#      Sensitive fields also present: phone (if provided), message (if provided).
#
# Required for analytics events and contact form submissions to be recorded.
VITE_ANALYTICS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
