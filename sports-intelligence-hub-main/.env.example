# Jira Integration (Server-side)
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=KAN

# Google Apps Script Analytics Backend
# Paste your deployed Web App /exec URL here.
# Get it from: Apps Script → Deploy → Manage Deployments → Web app URL
# Required for analytics events (greeting_shown, navigation_context_shown, etc.)
# to be sent as HTTP POST requests to your Google Sheet.
VITE_ANALYTICS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
